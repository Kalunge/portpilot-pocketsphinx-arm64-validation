{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/dependency-inventory.schema.json",
  "title": "PortPilot dependency inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "generatedAt", "dependencies"],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "source",
          "evidence",
          "role",
          "inProcess",
          "architectures"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cmake-package",
              "cmake-fetch",
              "bundled",
              "python",
              "vcpkg"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["build", "runtime", "optional", "unknown"]
          },
          "inProcess": {
            "type": ["boolean", "null"]
          },
          "architectures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["x86", "x64", "arm64", "arm64ec", "portable", "unknown"]
            }
          }
        }
      }
    }
  }
}
