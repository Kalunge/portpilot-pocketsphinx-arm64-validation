{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/project.schema.json",
  "title": "PortPilot run project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "manifest",
    "projectId",
    "source",
    "target",
    "status",
    "stages",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "checkoutDirectory", "workspace"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checkoutDirectory": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture"],
      "properties": {
        "operatingSystem": {
          "const": "windows"
        },
        "architecture": {
          "enum": ["arm64", "arm64ec"]
        }
      }
    },
    "status": {
      "enum": [
        "created",
        "analyzing",
        "analyzed",
        "planned",
        "running",
        "validating",
        "completed",
        "failed",
        "blocked"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis", "planning", "execution", "reporting"],
      "properties": {
        "analysis": {
          "$ref": "#/$defs/stageStatus"
        },
        "planning": {
          "$ref": "#/$defs/stageStatus"
        },
        "execution": {
          "$ref": "#/$defs/stageStatus"
        },
        "reporting": {
          "$ref": "#/$defs/stageStatus"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "stageStatus": {
      "enum": ["pending", "in-progress", "done", "failed", "blocked"]
    }
  }
}
