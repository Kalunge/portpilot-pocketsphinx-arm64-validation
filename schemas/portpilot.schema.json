{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/portpilot.schema.json",
  "title": "PortPilot application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "source",
    "target",
    "toolchain",
    "build",
    "validation",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "license", "homepage"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "checkoutDirectory",
        "submodules",
        "lineEndings"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "checkoutDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "submodules": {
          "type": "boolean"
        },
        "lineEndings": {
          "enum": ["native", "lf", "crlf"]
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "strip": {
                "type": "integer",
                "minimum": 0,
                "default": 1
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "contains"],
                  "properties": {
                    "path": {
                      "$ref": "#/$defs/relativePath"
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "default": []
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "path", "sha256"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "default": []
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "architecture",
        "runner",
        "configuration"
      ],
      "properties": {
        "operatingSystem": {
          "const": "windows"
        },
        "architecture": {
          "enum": ["arm64", "arm64ec"]
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "enum": ["Debug", "Release", "RelWithDebInfo", "MinSizeRel"]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "probes"],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "packages"],
            "properties": {
              "manager": {
                "enum": ["chocolatey", "pip", "winget"]
              },
              "packages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "pathEntries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "architecture"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^3\\.[0-9]+$"
            },
            "architecture": {
              "enum": ["arm64", "x64"]
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "sourceDirectory",
        "buildDirectory",
        "variants",
        "definitions",
        "commands"
      ],
      "properties": {
        "system": {
          "const": "cmake"
        },
        "sourceDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "buildDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "target"],
          "properties": {
            "baseline": {
              "$ref": "#/$defs/buildVariant"
            },
            "target": {
              "$ref": "#/$defs/buildVariant"
            }
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/command"
              },
              {
                "type": "object",
                "required": ["phases"],
                "properties": {
                  "phases": {
                    "$ref": "#/$defs/phases"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "testSuites", "scenarios"],
      "properties": {
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedMachine", "files"],
          "properties": {
            "expectedMachine": {
              "enum": ["ARM64", "ARM64EC"]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        },
        "testSuites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "phases",
              "command",
              "resultFormat",
              "failurePolicy"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "phases": {
                "$ref": "#/$defs/phases"
              },
              "command": {
                "$ref": "#/$defs/command"
              },
              "resultFormat": {
                "enum": ["ctest", "pytest", "exit-code"]
              },
              "resultPath": {
                "$ref": "#/$defs/relativePath"
              },
              "failurePolicy": {
                "enum": ["all-pass", "no-new-failures", "allow-listed"]
              },
              "knownFailures": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "phases", "command", "expected"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "phases": {
                "$ref": "#/$defs/phases"
              },
              "command": {
                "$ref": "#/$defs/command"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["exitCode"],
                "properties": {
                  "exitCode": {
                    "type": "integer"
                  },
                  "outputContains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "referenceFile": {
                    "$ref": "#/$defs/relativePath"
                  },
                  "normalization": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "trim",
                        "lowercase",
                        "collapse-whitespace",
                        "strip-timestamps"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "buildCommand",
            "artifactPattern",
            "platformTag",
            "nativeFiles",
            "cleanInstall"
          ],
          "properties": {
            "kind": {
              "const": "python-wheel"
            },
            "buildCommand": {
              "$ref": "#/$defs/command"
            },
            "artifactPattern": {
              "$ref": "#/$defs/relativePath"
            },
            "platformTag": {
              "const": "win_arm64"
            },
            "nativeFiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\*\\.(pyd|dll|exe)$"
              }
            },
            "cleanInstall": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runner", "commands"],
              "properties": {
                "runner": {
                  "type": "string",
                  "minLength": 1
                },
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/command"
                  }
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "retentionDays"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/relativePath"
            }
          },
          "retentionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "requiredRecords"],
      "properties": {
        "directory": {
          "$ref": "#/$defs/relativePath"
        },
        "requiredRecords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "environment",
              "source",
              "architecture-decision",
              "inventory",
              "findings",
              "task-graph",
              "build",
              "tests",
              "architecture",
              "runtime",
              "package",
              "report"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:|[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        }
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["baseline", "target"]
      }
    },
    "buildVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "architecture", "platform"],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "enum": ["x64", "arm64", "arm64ec"]
        },
        "platform": {
          "enum": ["x64", "ARM64", "ARM64EC"]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executable", "arguments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "continueOnError": {
          "type": "boolean",
          "default": false
        },
        "appendDefinitions": {
          "type": "boolean",
          "default": false
        },
        "capture": {
          "$ref": "#/$defs/relativePath"
        },
        "phases": {
          "$ref": "#/$defs/phases"
        }
      }
    }
  }
}
