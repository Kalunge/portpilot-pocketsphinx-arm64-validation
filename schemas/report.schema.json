{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/report.schema.json",
  "title": "PortPilot release-readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "projectId",
    "sourceRevision",
    "targetArchitecture",
    "architectureDecision",
    "summary",
    "gates",
    "evidence",
    "remainingRisks",
    "verdict"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "targetArchitecture": {
      "enum": ["arm64", "arm64ec"]
    },
    "architectureDecision": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "tasks", "tests", "unexpectedFailures"],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "unexpectedFailures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "status": {
            "enum": ["passed", "failed", "blocked", "not-applicable"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remainingRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": ["ready", "conditionally-ready", "not-ready"]
    }
  }
}
