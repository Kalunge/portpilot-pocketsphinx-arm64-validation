{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/inventory.schema.json",
  "title": "PortPilot repository inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "generatedAt",
    "languages",
    "buildSystems",
    "packageSystems",
    "nativeDependencies",
    "binaryFiles"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fileCount"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fileCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "buildSystems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packageSystems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nativeDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "architectures"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "architectures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["x86", "x64", "arm64", "arm64ec", "portable", "unknown"]
            }
          }
        }
      }
    },
    "binaryFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "machine"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["exe", "dll", "pyd", "lib", "other"]
          },
          "machine": {
            "enum": ["x86", "x64", "arm64", "arm64ec", "unknown", "not-pe"]
          }
        }
      }
    }
  }
}
