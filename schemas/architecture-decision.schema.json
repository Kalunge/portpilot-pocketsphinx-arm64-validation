{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portpilot.dev/schemas/architecture-decision.schema.json",
  "title": "PortPilot architecture decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "generatedAt",
    "selectedArchitecture",
    "confidence",
    "rationale",
    "evidence",
    "blockers"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "selectedArchitecture": {
      "enum": ["arm64", "arm64ec", "blocked"]
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
